{
  "name": "converte-ai-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Converte AI",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "node --env-file=.env --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "test": "jest --watchman=false",
    "test:unit": "jest --watchman=false --selectProjects unit",
    "test:integration": "jest --watchman=false --selectProjects integration"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
